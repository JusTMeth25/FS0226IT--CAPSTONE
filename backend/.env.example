# Connection string Postgres (Neon/Supabase/locale). Includi ?sslmode=require per Neon/Supabase.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Segreto per firma JWT: genera il tuo con `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET="changeme"
JWT_EXPIRES_IN="7d"

PORT=4000
NODE_ENV=development

# Segreto per proteggere POST /api/migrate in produzione (non usato in development)
MIGRATE_SECRET="dev-only"

# Chiave OpenAI opzionale (generazione varianti carta, feature 9 futura)
OPENAI_API_KEY=

# Import carte esterne (Fase 2) - facoltative, alcune API pubbliche funzionano anche senza key
POKEMONTCG_API_KEY=
# Richiesta solo per l'import Gundam (registrazione gratuita su https://apitcg.com/platform).
# Senza questa key l'import Gundam usa automaticamente le carte demo di fallback.
APITCG_API_KEY=
