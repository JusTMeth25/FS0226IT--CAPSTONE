generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum MarketListingStatus {
  ACTIVE
  SOLD
  CANCELLED
}

enum TradeStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum TradeItemDirection {
  OFFERED
  REQUESTED
}

enum PackOpenMode {
  PAID
  FREE
  GIFT
}

enum WalletTransactionType {
  PACK_OPEN_PAID
  PACK_OPEN_FREE
  MARKET_SALE
  MARKET_PURCHASE
  TRADE
  MISSION_REWARD
  LEVEL_REWARD
  ALBUM_REWARD
  DAILY_LOGIN
  BATTLE_REWARD
  ADMIN_ADJUST
}

model User {
  id             String       @id @default(uuid())
  username       String       @unique
  email          String       @unique
  passwordHash   String
  gold           Int          @default(150)
  xp             Int          @default(0)
  level          Int          @default(1)
  role           UserRole     @default(USER)
  avatar         String?
  banned         Boolean      @default(false)
  banReason      String?
  lastFreePackAt DateTime?
  lastLoginDate  DateTime?
  loginStreak    Int          @default(0)
  battlesWon     Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  userCards        UserCard[]
  userMissions     UserMission[]
  packOpenings     PackOpening[]
  marketListings   MarketListing[]
  walletTxs        UserWalletTransaction[]
  packCredits      UserPackCredit[]
  tradesSent       Trade[]                 @relation("TradesSent")
  tradesReceived   Trade[]                 @relation("TradesReceived")
}

// Pacchetti "regalati" da missioni/livelli/eventi, da aprire gratis (mode "gift").
model UserPackCredit {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  packCode String
  quantity Int    @default(0)

  @@unique([userId, packCode])
}

model ArtistClass {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  iconUrl     String?
  createdAt   DateTime @default(now())

  cards       Card[]
}

model Card {
  id            String       @id @default(uuid())
  code          String       @unique
  name          String
  artistClassId String?
  artistClass   ArtistClass? @relation(fields: [artistClassId], references: [id])
  variant       String?
  group         String?
  rarity        String
  imgUrl        String?
  fullImage     Boolean      @default(false)
  fans          Int          @default(0)
  style         Int          @default(0)
  influence     Int          @default(0)
  energy        Int          @default(0)
  description   String?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())

  // Import da API esterne (Pokemon TCG / Scryfall / Yu-Gi-Oh!)
  source        String       @default("original")
  externalId    String?
  setName       String?
  setCode       String?
  number        String?
  metadata      Json?

  userCards        UserCard[]
  packOpeningCards PackOpeningCard[]
  marketListings   MarketListing[]
  tradeItems       TradeItem[]
  albumCards       AlbumCard[]

  @@unique([source, externalId])
}

model UserCard {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  cardId     String
  card       Card     @relation(fields: [cardId], references: [id])
  obtainedAt DateTime @default(now())
  isFavorite Boolean  @default(false)
  quantity   Int      @default(1)

  @@unique([userId, cardId])
}

model Pack {
  id                String           @id @default(uuid())
  code              String           @unique
  name              String
  description       String?
  priceGold         Int
  cardCount         Int
  isFree            Boolean          @default(false)
  freeCooldownHours Int              @default(0)
  imgUrl            String?
  isActive          Boolean          @default(true)
  eventId           String?
  event             Event?           @relation(fields: [eventId], references: [id])
  createdAt         DateTime         @default(now())

  packDropRates    PackDropRate[]
  packGuarantees   PackGuarantee[]
  packOpenings     PackOpening[]
}

model PackDropRate {
  id     String @id @default(uuid())
  packId String
  pack   Pack   @relation(fields: [packId], references: [id])
  rarity String
  weight Float

  @@unique([packId, rarity])
}

model PackGuarantee {
  id     String @id @default(uuid())
  packId String
  pack   Pack   @relation(fields: [packId], references: [id])
  rarity String
  count  Int

  @@unique([packId, rarity])
}

model PackOpening {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  packId    String
  pack      Pack         @relation(fields: [packId], references: [id])
  mode      PackOpenMode @default(PAID)
  goldSpent Int          @default(0)
  createdAt DateTime     @default(now())

  cards PackOpeningCard[]
}

model PackOpeningCard {
  id            String      @id @default(uuid())
  packOpeningId String
  packOpening   PackOpening @relation(fields: [packOpeningId], references: [id])
  cardId        String
  card          Card        @relation(fields: [cardId], references: [id])
  rarity        String
  createdAt     DateTime    @default(now())
}

model MarketListing {
  id            String              @id @default(uuid())
  sellerId      String
  seller        User                @relation(fields: [sellerId], references: [id])
  cardId        String
  card          Card                @relation(fields: [cardId], references: [id])
  quantity      Int
  pricePerUnit  Int
  status        MarketListingStatus @default(ACTIVE)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model Trade {
  id            String      @id @default(uuid())
  fromUserId    String
  fromUser      User        @relation("TradesSent", fields: [fromUserId], references: [id])
  toUserId      String
  toUser        User        @relation("TradesReceived", fields: [toUserId], references: [id])
  status        TradeStatus @default(PENDING)
  offeredGold   Int         @default(0)
  requestedGold Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  items TradeItem[]
}

model TradeItem {
  id        String              @id @default(uuid())
  tradeId   String
  trade     Trade               @relation(fields: [tradeId], references: [id])
  cardId    String
  card      Card                @relation(fields: [cardId], references: [id])
  quantity  Int
  direction TradeItemDirection
}

model UserWalletTransaction {
  id            String                @id @default(uuid())
  userId        String
  user          User                  @relation(fields: [userId], references: [id])
  amount        Int
  type          WalletTransactionType
  balanceAfter  Int
  relatedId     String?
  note          String?
  createdAt     DateTime              @default(now())
}

model ExternalCardSource {
  id              String   @id @default(uuid())
  source          String   @unique
  lastImportedAt  DateTime?
  totalImported   Int      @default(0)
  lastError       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Mission {
  id          String        @id @default(uuid())
  code        String        @unique
  title       String
  description String?
  type        String
  targetValue Int
  rewardGold  Int           @default(0)
  rewardXp    Int           @default(0)
  rewardPack  String?
  isDaily     Boolean       @default(false)
  isActive    Boolean       @default(true)
  eventId     String?
  event       Event?        @relation(fields: [eventId], references: [id])
  metadata    Json?
  createdAt   DateTime      @default(now())

  userMissions UserMission[]
}

model UserMission {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  missionId   String
  mission     Mission   @relation(fields: [missionId], references: [id])
  progress    Int       @default(0)
  completed   Boolean   @default(false)
  claimed     Boolean   @default(false)
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@unique([userId, missionId])
}

model Event {
  id                     String   @id @default(uuid())
  code                   String   @unique
  name                   String
  description            String?
  startsAt               DateTime?
  endsAt                 DateTime?
  bonusDropRateMultiplier Float   @default(1)
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())

  packs    Pack[]
  missions Mission[]
}

model Album {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  coverImgUrl String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  albumCards AlbumCard[]
}

model AlbumCard {
  id      String @id @default(uuid())
  albumId String
  album   Album  @relation(fields: [albumId], references: [id])
  cardId  String
  card    Card   @relation(fields: [cardId], references: [id])

  @@unique([albumId, cardId])
}
