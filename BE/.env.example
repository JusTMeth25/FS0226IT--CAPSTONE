# Variabili d'ambiente del backend Spring Boot.
# Copiare in .env (gitignorato) oppure esportarle nella shell prima di avviare.

# --- Database locale (createdb -U postgres -E UTF8 vinyldex) ---
DB_URL=jdbc:postgresql://localhost:5432/vinyldex
DB_USERNAME=postgres
DB_PASSWORD=

# --- JWT ---
# Almeno 32 byte. Se cambia, i token gia' emessi smettono di funzionare e tutti devono
# rifare il login. Per generarne uno nuovo:
#   openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Server ---
PORT=4000

# Origini ammesse dal browser, separate da virgola (dev server e anteprima di Vite).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173

# --- Import carte esterne (facoltativi) ---
# Pokemon TCG funziona anche senza chiave, ma con limiti di richieste piu' bassi.
POKEMONTCG_API_KEY=
# Richiesta solo per l'import Gundam (registrazione gratuita su apitcg.com/platform).
# Senza questa chiave l'import Gundam ricade automaticamente sulle carte demo.
APITCG_API_KEY=

# --- Generazione immagini (facoltativa) ---
OPENAI_API_KEY=

# --- NPC dell'hotel con intelligenza artificiale (facoltativo) ---
# Chiave gratuita di openrouter.ai: gli NPC usano solo modelli ":free", quindi senza credito
# sull'account non si spende nulla. Senza chiave, o finite le circa 50 risposte gratuite al
# giorno, gli NPC rispondono con le battute a parole chiave.
OPENROUTER_API_KEY=

# Carte EA FC 27 Ultimate Team: chiave gratuita di https://futdb.app (facoltativa).
# Senza chiave le carte vengono dall'elenco fisso del progetto, con prezzi indicativi.
FUTDB_API_KEY=

# --- Accesso con Google e Apple (facoltativo) ---
# Senza questi valori i pulsanti "Continua con Google/Apple" non compaiono. Sono id pubblici,
# non segreti. Google Cloud Console > API e servizi > Credenziali > ID client OAuth:
#  - "Applicazione web" (serve per web E per Android: il token che riceve l'app Android e' per lui);
#  - "Android" con package com.vinyldex.app e SHA-1 della chiave di firma (non va scritto qui);
#  - "iOS" con bundle id com.vinyldex.app.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
# Apple Developer > Identifiers: Services ID per il login dal browser (dominio e redirect
# registrati da Apple) e capability "Sign in with Apple" sull'App ID per l'app iOS.
APPLE_SERVICE_ID=
APPLE_REDIRECT_URL=
APPLE_BUNDLE_ID=com.vinyldex.app
APPLE_IOS_ENABLED=false

# --- Email (reset della password) con Brevo ---
# Brevo > SMTP & API > SMTP: server, porta, login e una chiave SMTP (non la password dell'account).
# MAIL_FROM deve essere un mittente verificato su Brevo (Senders, Domains & Dedicated IPs).
# Senza MAIL_HOST non parte nessuna email: il link di reset si legge nel log del backend.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=VinylDex
# Indirizzo del frontend usato nei link delle email.
APP_URL=http://localhost:5173

# --- Verifica in due passaggi ---
# Giorni per cui un dispositivo resta fidato (si rinnovano a ogni accesso).
TWO_FACTOR_TRUST_DAYS=30
# Chiave per cifrare i segreti dell'app dei codici; se vuota si usa JWT_SECRET.
# Una volta scelta non va cambiata, altrimenti chi ha la verifica attiva deve rifarla.
TWO_FACTOR_KEY=
