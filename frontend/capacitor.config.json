{
  "appId": "com.vinyldex.app",
  "appName": "VinylDex",
  "webDir": "dist",
  "backgroundColor": "#050816",
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#050816",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#050816"
    },
    "SocialLogin": {
      "providers": {
        "google": true,
        "apple": false,
        "facebook": false,
        "twitter": false
      },
      "logLevel": 1
    }
  },
  "android": {
    "backgroundColor": "#050816"
  },
  "ios": {
    "backgroundColor": "#050816",
    "contentInset": "automatic"
  }
}
