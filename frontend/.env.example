# Copia questo file in .env.local e metti i tuoi valori (.env.local non va su git).

# Spotify per il jukebox delle stanze (facoltativo): Client ID dell'app creata su
# https://developer.spotify.com/dashboard (API: Web API + Web Playback SDK). Nell'app registra
# come Redirect URI http://127.0.0.1:5173/callback (Spotify non accetta "localhost").
# Senza Client ID il jukebox usa solo le anteprime di Apple Music.
VITE_SPOTIFY_CLIENT_ID=
# Facoltativo: redirect diverso da <indirizzo del sito>/callback.
# VITE_SPOTIFY_REDIRECT_URI=
