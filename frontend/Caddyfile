# Sito pubblico di VinylDex. DOMAIN arriva da deploy/.env: col nome di un dominio (vinyldex.eu.org)
# Caddy chiede da solo il certificato HTTPS; con ":80" serve in http sull'IP, per le prime prove.
{$DOMAIN} {
	encode zstd gzip

	# API e WebSocket dell'hotel al backend (Caddy inoltra anche l'upgrade del WebSocket).
	handle /api/* {
		reverse_proxy backend:4000
	}
	handle /ws/* {
		reverse_proxy backend:4000
	}
	handle /health {
		reverse_proxy backend:4000
	}

	# Frontend: i file con l'hash nel nome si tengono in cache a lungo, index.html mai.
	handle {
		root * /srv
		@hashed path /assets/*.js /assets/*.css
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@page not path /assets/*
		header @page Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	# Intestazioni di sicurezza.
	# - Content-Security-Policy: gli script vengono solo da qui e dai pochi servizi usati davvero
	#   (Spotify Web Playback SDK, accesso con Apple); niente script in linea ne' eval, quindi un
	#   testo maligno finito in pagina non puo' eseguire codice ('wasm-unsafe-eval' ammette solo
	#   WebAssembly, per i modelli 3D compressi). Immagini e audio da qualsiasi
	#   https (le carte arrivano da molti siti). frame-ancestors: nessun sito ci mette in un iframe.
	# - X-Frame-Options: lo stesso divieto per i browser vecchi (clickjacking).
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://sdk.scdn.co https://appleid.cdn-apple.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' wss://{host} https://api.spotify.com https://accounts.spotify.com https://itunes.apple.com https://www.googleapis.com https://appleid.apple.com; frame-src https://sdk.scdn.co https://accounts.google.com https://appleid.apple.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://appleid.apple.com; frame-ancestors 'none'"
		-Server
	}
}
