# Sito pubblico di VinylDex. DOMAIN arriva da deploy/.env: col nome di un dominio (vinyldex.eu.org)
# Caddy chiede da solo il certificato HTTPS; con ":80" serve in http sull'IP, per le prime prove.
{$DOMAIN} {
	encode zstd gzip

	# API e WebSocket dell'hotel al backend (Caddy inoltra anche l'upgrade del WebSocket).
	handle /api/* {
		reverse_proxy backend:4000
	}
	handle /ws/* {
		reverse_proxy backend:4000
	}
	handle /health {
		reverse_proxy backend:4000
	}

	# Frontend: i file con l'hash nel nome si tengono in cache a lungo, index.html mai.
	handle {
		root * /srv
		@hashed path /assets/*.js /assets/*.css
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@page not path /assets/*
		header @page Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
