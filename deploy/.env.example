# Variabili di produzione di VinylDex. Sul server: cp .env.example .env, poi compila.
# Questo file (.env) non va mai in git: contiene password e chiavi.

# --- Indirizzo pubblico ---
# Col dominio attivo: DOMAIN=vinyldex.eu.org e PUBLIC_URL=https://vinyldex.eu.org
# (Caddy prende da solo il certificato HTTPS). Per le prime prove senza dominio, sull'IP del server:
# DOMAIN=:80 e PUBLIC_URL=http://<IP del server>
DOMAIN=vinyldex.eu.org
PUBLIC_URL=https://vinyldex.eu.org
# Altre origini ammesse, ognuna preceduta da una virgola (es. l'app Android di Capacitor):
EXTRA_CORS_ORIGINS=,https://localhost,http://localhost,capacitor://localhost

# --- Database (PostgreSQL nel container "db") ---
# Password lunga e casuale: openssl rand -base64 32
DB_PASSWORD=

# --- Sicurezza ---
# Chiave dei token di accesso: almeno 64 caratteri casuali (openssl rand -base64 64).
# Cambiarla fa uscire tutti gli utenti.
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Chiave che cifra i segreti della verifica in due passaggi: casuale e da non cambiare piu'
# (cambiandola, chi ha la 2FA attiva dovrebbe riconfigurarla).
TWO_FACTOR_KEY=
TWO_FACTOR_TRUST_DAYS=30

# --- Email (reset della password) con Brevo ---
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=VinylDex

# --- Accesso con Google ---
# Su Google Cloud Console aggiungi PUBLIC_URL fra le "Origini JavaScript autorizzate".
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# --- Chiavi delle API esterne (facoltative, come in BE/.env) ---
POKEMONTCG_API_KEY=
APITCG_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
FUTDB_API_KEY=

# --- Frontend (pubblico, letto alla build) ---
VITE_SPOTIFY_CLIENT_ID=

# --- Risorse ---
# Memoria massima del backend (la JVM ne usa il 60%). Sul server Oracle gratuito c'e' spazio.
BACKEND_MEMORY=4g
